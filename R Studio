# Function 1: Generate Dot Plot for Top Pathways
plot_gsea_dotplot <- function(gsea_df, db_label, top_n = 10) {
  top_up   <- gsea_df %>% filter(NES > 0) %>% slice_min(padj, n = top_n)
  top_down <- gsea_df %>% filter(NES < 0) %>% slice_min(padj, n = top_n)
  
  plot_df  <- bind_rows(top_up, top_down) %>%
    mutate(
      pathway_clean  = gsub("^HALLMARK_|^GOBP_", "", pathway),
      pathway_clean  = gsub("_", " ", pathway_clean),
      pathway_clean  = str_wrap(pathway_clean, width = 45),
      pathway_clean  = fct_reorder(pathway_clean, NES),
      neg_log10_padj = -log10(padj)
    )
  
  ggplot(plot_df, aes(x = NES, y = pathway_clean)) +
    geom_vline(xintercept = 0, linetype = "dashed", color = "gray60") +
    geom_point(aes(size = size, color = NES), alpha = 0.9) +
    scale_color_gradient2(
      low = "#084003", mid = "#FBFBF9", high = "#5C439D", midpoint = 0,
      name = "NES"
    ) +
    scale_size_continuous(name = "Gene Set Size", range = c(3, 8)) +
    theme_classic(base_size = 11) +
    labs(
      title = paste0("Top Enriched Pathways: ", db_label),
      x     = "Normalized Enrichment Score (NES)",
      y     = NULL
    ) +
    theme(
      plot.title         = element_text(face = "bold", size = 12, hjust = 0.5),
      axis.text.y        = element_text(size = 8.5, face = "bold"),
      axis.title.x       = element_text(face = "bold", size = 10),
      panel.grid.major.y = element_line(color = "#F0F0F0")
    )
}

# Function 2: Single Mountain Plot with Palette Context
plot_single_mountain <- function(pathway_name, pathways_list, stats, nes, padj, pval) {
  gsea_curve <- plotEnrichmentData(pathway = pathways_list[[pathway_name]], stats = stats)
  
  line_col <- if (nes >= 0) "#5C439D" else "#084003"
  bg_col   <- if (nes >= 0) "#F2EFFB" else "#E8F0E6"
  txt_col  <- if (nes >= 0) "#3A2272" else "#042001"
  
  pathway_clean <- gsub("^HALLMARK_|^GOBP_", "", pathway_name)
  pathway_clean <- gsub("_", " ", pathway_clean)
  
  ggplot(gsea_curve$curve, aes(x = rank, y = ES)) +
    geom_line(color = line_col, linewidth = 1.2) +
    geom_hline(yintercept = 0, linetype = "dashed", color = "gray50", linewidth = 0.5) +
    geom_segment(data = gsea_curve$ticks, 
                 aes(x = rank, xend = rank, y = -0.05, yend = -0.01), 
                 color = "#084003", alpha = 0.7, linewidth = 0.4) +
    theme_classic(base_size = 11) +
    labs(
      title = paste0("GSEA: ", pathway_clean),
      x     = paste0("Rank in Ordered Dataset (Genome-Wide ", rank_col, ")"),
      y     = "Running Enrichment Score (ES)"
    ) +
    annotate(
      "label", 
      x     = max(gsea_curve$curve$rank) * 0.75, 
      y     = ifelse(nes >= 0, max(gsea_curve$curve$ES) * 0.85, min(gsea_curve$curve$ES) * 0.85),
      label = paste0("NES = ", sprintf("%.2f", nes), 
                     "\nNominal p = ", formatC(pval, format = "e", digits = 2), 
                     "\nFDR q = ", formatC(padj, format = "e", digits = 2)),
      fill  = bg_col, color = txt_col, fontface = "bold", size = 3.5
    ) +
    theme(
      plot.title       = element_text(face = "bold", size = 11, hjust = 0.5),
      axis.title       = element_text(face = "bold", size = 10),
      panel.grid.major = element_line(color = "#F5F5F5")
    )
}

