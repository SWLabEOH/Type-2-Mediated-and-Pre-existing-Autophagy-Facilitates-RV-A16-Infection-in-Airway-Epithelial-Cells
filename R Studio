# Function 3: Differential Expression Volcano Plot (2-Fold, Raw P < 0.01, Top 5 Labeled)
plot_volcano <- function(de_df, 
                         logfc_col = "logFC", 
                         pval_col = "P.Value",      # Uses raw P-value
                         lfc_cutoff = 1.0,          # 2-fold change (log2(2) = 1.0)
                         p_cutoff = 0.01,           # Raw P < 0.01
                         top_n_label = 5) {         # Labels top 5 per side
  
  if (!logfc_col %in% colnames(de_df)) {
    logfc_col <- intersect(c("logFC", "log2FC"), colnames(de_df))[1]
  }
  if (!pval_col %in% colnames(de_df)) {
    pval_col <- intersect(c("P.Value", "p.value", "adj.P.Val"), colnames(de_df))[1]
  }
  
  v_df <- de_df %>%
    filter(!is.na(.data[[logfc_col]]), !is.na(.data[[pval_col]])) %>%
    mutate(
      neg_log10_p = -log10(.data[[pval_col]]),
      status = case_when(
        .data[[pval_col]] < p_cutoff & .data[[logfc_col]] >= lfc_cutoff  ~ "Up",
        .data[[pval_col]] < p_cutoff & .data[[logfc_col]] <= -lfc_cutoff ~ "Down",
        TRUE                                                             ~ "Not Sig"
      ),
      status = factor(status, levels = c("Up", "Down", "Not Sig"))
    )
  
  top_up <- v_df %>%
    filter(status == "Up") %>%
    slice_min(order_by = .data[[pval_col]], n = top_n_label, with_ties = FALSE)
  
  top_down <- v_df %>%
    filter(status == "Down") %>%
    slice_min(order_by = .data[[pval_col]], n = top_n_label, with_ties = FALSE)
  
  labeled_genes <- bind_rows(top_up, top_down)
  
  n_up   <- sum(v_df$status == "Up")
  n_down <- sum(v_df$status == "Down")
  message(sprintf("Volcano Plot Highlights: %d Upregulated | %d Downregulated (Raw P < %.2f, |log2FC| >= %.1f)",
                  n_up, n_down, p_cutoff, lfc_cutoff))
  
  ggplot(v_df, aes(x = .data[[logfc_col]], y = neg_log10_p)) +
    geom_point(aes(color = status), alpha = 0.6, size = 1.5) +
    geom_point(data = labeled_genes, aes(x = .data[[logfc_col]], y = neg_log10_p, color = status),
               size = 2.2, shape = 21, stroke = 0.8, fill = NA) +
    geom_vline(xintercept = c(-lfc_cutoff, lfc_cutoff), linetype = "dashed", color = "gray50", linewidth = 0.4) +
    geom_hline(yintercept = -log10(p_cutoff), linetype = "dashed", color = "gray50", linewidth = 0.4) +
    geom_text_repel(
      data = labeled_genes,
      aes(label = gene_name),
      size = 3.2,
      fontface = "bold.italic",
      box.padding = 0.5,
      point.padding = 0.3,
      segment.color = "gray40",
      segment.size = 0.3,
      max.overlaps = Inf
    ) +
    scale_color_manual(
      values = c("Up" = "#5C439D", "Down" = "#084003", "Not Sig" = "#B0BEC5"),
      labels = c("Up" = "Up", "Down" = "Down", "Not Sig" = "Not Significant")
    ) +
    theme_classic(base_size = 11) +
    labs(
      title = "Volcano Plot: Nominal Differential Expression",
      subtitle = sprintf("Cutoffs: Raw P < %.2f, |FC| >= 2.0 (log2FC >= 1.0)", p_cutoff),
      x     = "Log2 Fold Change",
      y     = "-Log10 Raw P-value",
      color = "Expression Status"
    ) +
    theme(
      plot.title      = element_text(face = "bold", size = 12, hjust = 0.5),
      plot.subtitle   = element_text(size = 9.5, hjust = 0.5, face = "italic"),
      axis.title      = element_text(face = "bold", size = 10),
      legend.position = "top",
      legend.title    = element_text(face = "bold", size = 9)
    )
}

