colnames(mat_rawp) <- "Raw P-Val"
rownames(mat_rawp) <- ifn_matched$gene_name

# Diverging Log2FC Color Ramp: Forest Green (#084003) -> Off-White -> Medium Purple (#998CDC) -> Deep Purple (#5C439D)
fc_limit <- quantile(abs(c(mat_4col, mat_1col)), 0.95, na.rm = TRUE)
col_fc   <- colorRamp2(
  c(-fc_limit, -fc_limit*0.25, 0, fc_limit*0.25, fc_limit), 
  c("#084003", "#2E6928", "#FBFBF9", "#998CDC", "#5C439D") 
)

# Sequential Significance P-value Color Ramp: Lavender (#E8E3F5) -> Deep Purple (#5C439D)
max_p_val <- max(c(mat_fdr, mat_target_fdr, mat_rawp), na.rm = TRUE)
col_pval  <- colorRamp2(
  c(0, 1.30, max(3, max_p_val * 0.5), max(4, max_p_val)), 
  c("#E8E3F5", "#B8ACDC", "#7C63B8", "#3A2272") 
)

