# ==============================================================================
# PRE-PART 0: RAW HTSEQ COUNT MATRIX ASSEMBLY & CLEANING
# Pipeline: Primary Human Airway Epithelial Cell Transcriptomics
# Software: R (v4.0+), tidyverse, fs
# Description: 
#   1. Locates individual sample HTSeq count files recursively.
#   2. Imports counts while stripping HTSeq summary metrics (e.g., _no_feature).
#   3. Merges samples into a unified matrix, imputing 0s for missing features.
#   4. Exports the combined raw count matrix.
# ==============================================================================

library(tidyverse)
library(fs)

# ------------------------------------------------------------------------------
# STEP 1: Set Working Directory & Locate Raw HTSeq .tsv Files
# ------------------------------------------------------------------------------
# Set execution working directory environment (adjust path as needed)
# setwd("path/to/your/folder")

# Find and locate all raw HTSeq .tsv files
files <- dir_ls("folder", recurse = TRUE, glob = "*.tsv")
sample_names <- path_ext_remove(path_file(files))

# ------------------------------------------------------------------------------
# STEP 2: Iteratively Read Files and Clean HTSeq Summary Statistics
# ------------------------------------------------------------------------------
count_data <- map2(files, sample_names, function(file_path, sample) {
  read_tsv(file_path, col_names = c("Gene", sample), col_types = "ci") %>%
    filter(!str_starts(Gene, "_"))  # Strips out _no_feature, _ambiguous, etc.
}) 

# ------------------------------------------------------------------------------
# STEP 3: Merge Samples and Handle Structural Layout
# ------------------------------------------------------------------------------
gene_matrix <- reduce(count_data, full_join, by = "Gene") %>%
  mutate(across(where(is.numeric), ~replace_na(., 0))) %>%
  column_to_rownames("Gene")

# ------------------------------------------------------------------------------
# STEP 4: Save Raw Combined Matrix
# ------------------------------------------------------------------------------
gene_matrix %>% 
  rownames_to_column("Gene") %>% 
  write_tsv("gene_count_matrix.tsv")

message("PRE-PART 0 COMPLETE: Raw count matrix successfully assembled and exported as 'gene_count_matrix.tsv'!\n")




# ==============================================================================
# PART 0: GENE COUNT FILTERING USING edgeR::filterByExpr()
# Pipeline: Primary Human Airway Epithelial Cell Transcriptomics
# Software: R (v4.0+), edgeR, tidyverse
# Description: Constructs DGEList, applies TMM normalization, and filters low-expressed genes using filterByExpr() under a paired (~ Plate + Condition) design.
# ==============================================================================

library(tidyverse)
library(edgeR)

# ------------------------------------------------------------------------------
# STEP 1: Load Data & Define Experimental Metadata
# ------------------------------------------------------------------------------
# Load raw count matrix (assumes gene names are in the first column or rownames)
raw_counts <- read_tsv("gene_count_matrix.tsv") %>%
  column_to_rownames(var = colnames(.)[1])

# Define experimental design metadata
metadata <- data.frame(
  Sample    = c("B11", "B12", "B13", "B14", "B15", "B16", "B17", "B18"),
  Plate     = factor(c("P1", "P1", "P2", "P2", "P3", "P3", "P4", "P4")),
  Condition = factor(c("Cond3", "Cond4", "Cond3", "Cond4", "Cond3", "Cond4", "Cond3", "Cond4"))
)

# Align matrix columns with metadata sample order
raw_counts <- raw_counts[, metadata$Sample]

# ------------------------------------------------------------------------------
# STEP 2: Construct DGEList & Design Matrix
# ------------------------------------------------------------------------------
# Model matrix accounting for paired plate design
design <- model.matrix(~ Plate + Condition, data = metadata)

# Create DGEList object and calculate TMM normalization factors
dge_raw <- DGEList(counts = raw_counts, group = metadata$Condition)
dge_raw <- calcNormFactors(dge_raw, method = "TMM")

cat("Total initial features in raw matrix:", nrow(dge_raw), "\n\n")

# ------------------------------------------------------------------------------
# STEP 3: Iterate Over min.count Thresholds & Export Filtered TSV Files
# ------------------------------------------------------------------------------
thresholds <- c(20)

for (mc in thresholds) {
  
  # Run filterByExpr with current min.count threshold
  # Note: filterByExpr evaluates design leverage values to derive effective min
  keep_genes <- filterByExpr(dge_raw, design = design, min.count = mc)
  
  # Subset DGEList and re-calculate library sizes
  dge_filtered <- dge_raw[keep_genes, , keep.lib.sizes = FALSE]
  
  # Extract count matrix
  filtered_matrix <- as.data.frame(dge_filtered$counts) %>%
    rownames_to_column(var = "Gene")
  
  # Generate output filename
  filename <- paste0("gene_count_matrix_filtered_exp2", mc, ".tsv")
  
  # Save to TSV
  write_tsv(filtered_matrix, filename)
  
  # Output diagnostic summary
  cat(sprintf("Threshold min.count = %2d  -->  Retained %5d genes (Removed %5d)  -->  Saved to: %s\n",
              mc, sum(keep_genes), nrow(dge_raw) - sum(keep_genes), filename))
}

cat("\nFiltering complete! Cleaned count matrix saved successfully.\n")




# ==============================================================================
# PART 1: PAIRED RNA-SEQ ANALYSIS VIA LIMMA-VOOM (PROTEIN-CODING ONLY)
# Pipeline: Primary Human Airway Epithelial Cell Transcriptomics
# Software: R (v4.0+), limma, edgeR, biomaRt, tidyverse
# Description: 
#   1. Pre-filters raw counts for canonical protein-coding genes via BioMart
#      (incorporating robust mirror & host failover loops).
#   2. Recalculates TMM normalization over protein-coding features.
#   3. Outputs paired plate log2FC matrix and 1-column DE
#      results with FDR (adj.P.Val) calculations.
# ==============================================================================

# ------------------------------------------------------------------------------
# STEP 1: Load Required Bioinformatics Libraries
# ------------------------------------------------------------------------------
library(edgeR)        # For DGEList container and TMM normalization
library(limma)        # For voom transformation, lmFit, and eBayes modeling
library(tidyverse)    # For data manipulation and piping
library(biomaRt)      # For Ensembl annotation retrieval

# ------------------------------------------------------------------------------
# STEP 2: Import Filtered Count Matrix & Establish Metadata
# ------------------------------------------------------------------------------
# Read raw count matrix (Genes as rows, Samples B11-B18 as columns)
counts <- read.table("gene_count_matrix_filtered_exp2.tsv", header = TRUE, row.names = 1, sep = "\t")

# Establish experimental design and metadata
metadata <- data.frame(
  Sample    = c("B11", "B12", "B13", "B14", "B15", "B16", "B17", "B18"),
  Plate     = factor(c("P1", "P1", "P2", "P2", "P3", "P3", "P4", "P4")),
  Condition = factor(c("Cond3", "Cond4", "Cond3", "Cond4", "Cond3", "Cond4", "Cond3", "Cond4"))
)
rownames(metadata) <- metadata$Sample

# Ensure count matrix columns match metadata rows
counts <- counts[, metadata$Sample]

# ------------------------------------------------------------------------------
# STEP 3: BioMart Mirror & Host Failover Loop for Protein-Coding Pre-Filtering
# ------------------------------------------------------------------------------
# Extract clean Ensembl IDs (strip version decimal numbers)
raw_ensembl_ids <- unique(gsub("\\..*", "", rownames(counts)))

get_biomart_connection <- function() {
  mirrors_to_try <- c("useast", "asia", "www")
  
  # 1. Try regional mirrors to bypass HTTP 404 / connection errors
  for (m in mirrors_to_try) {
    message(paste0("Attempting BioMart connection via mirror: '", m, "'..."))
    mart <- tryCatch({
      useEnsembl(
        biomart = "genes", 
        dataset = "hsapiens_gene_ensembl", 
        mirror  = m
      )
    }, error = function(e) {
      message(paste0("Mirror '", m, "' failed: ", e$message))
      return(NULL)
    })
    
    if (!is.null(mart)) {
      message(paste0("Successfully connected to BioMart via '", m, "' mirror!"))
      return(mart)
    }
  }
  
  # 2. Fallback to direct host URL if mirrors fail
  message("Attempting direct host connection to 'https://www.ensembl.org'...")
  mart <- tryCatch({
    useMart(
      biomart = "ENSEMBL_MART_ENSEMBL",
      dataset = "hsapiens_gene_ensembl",
      host    = "https://www.ensembl.org"
    )
  }, error = function(e) {
    stop("CRITICAL: All BioMart mirrors and direct host connections failed.")
  })
  
  return(mart)
}

# Establish mart connection
mart <- get_biomart_connection()

# Fetch gene biotypes with primary + fallback tryCatch
message("Fetching gene biotypes from BioMart...")
gene_annot_raw <- tryCatch({
  getBM(
    attributes = c("ensembl_gene_id", "gene_biotype"),
    filters    = "ensembl_gene_id",
    values     = raw_ensembl_ids,
    mart       = mart
  )
}, error = function(e) {
  message("getBM failed on primary connection. Retrying with direct host...")
  fallback_mart <- useMart("ENSEMBL_MART_ENSEMBL", dataset = "hsapiens_gene_ensembl", host = "https://www.ensembl.org")
  getBM(
    attributes = c("ensembl_gene_id", "gene_biotype"),
    filters    = "ensembl_gene_id",
    values     = raw_ensembl_ids,
    mart       = fallback_mart
  )
})

# Filter for Ensembl IDs corresponding ONLY to protein_coding biotypes
protein_coding_ids <- gene_annot_raw %>%
  filter(gene_biotype == "protein_coding") %>%
  pull(ensembl_gene_id) %>%
  unique()

# Subset row features of original count matrix to keep ONLY protein-coding genes
clean_rownames <- gsub("\\..*", "", rownames(counts))
counts_pc <- counts[clean_rownames %in% protein_coding_ids, ]

cat(sprintf("\nPre-filtering complete:\n  Initial features: %d\n  Retained protein-coding genes: %d\n  Removed non-coding features: %d\n\n", 
            nrow(counts), nrow(counts_pc), nrow(counts) - nrow(counts_pc)))

# ------------------------------------------------------------------------------
# STEP 4: Create DGEList Object & Calculate TMM Normalization Factors
# ------------------------------------------------------------------------------
# Store protein-coding counts and sample metadata in structured DGEList
dge <- DGEList(counts = as.matrix(counts_pc), samples = metadata)

# Calculate TMM normalization factors across protein-coding feature set
dge <- calcNormFactors(dge, method = "TMM")

# ------------------------------------------------------------------------------
# STEP 5: Construct the Paired Experimental Design Matrix
# ------------------------------------------------------------------------------
# Define the paired fixed-effects blocking model formula: ~ Plate + Condition
design <- model.matrix(~ Plate + Condition, data = dge$samples)

# ------------------------------------------------------------------------------
# STEP 6: Perform Voom Transformation (Log2CPM + Precision Weights)
# ------------------------------------------------------------------------------
# Convert counts to log2CPM using TMM factors and estimate observational weights
v <- voom(dge, design, plot = TRUE)

# ------------------------------------------------------------------------------
# STEP 7: [REVIEWER OUTPUT] Extract 4-Column Plate-Level Paired Log2FC Matrix
# ------------------------------------------------------------------------------
# Extract normalized log2CPM expression matrix
log2cpm <- v$E

# Compute paired differences (Cond4 - Cond3) individually for each plate pair
paired_log2fc_4col <- data.frame(
  Plate1_log2FC = log2cpm[, "B12"] - log2cpm[, "B11"],  # P1: Cond4 (B12) - Cond3 (B11)
  Plate2_log2FC = log2cpm[, "B14"] - log2cpm[, "B13"],  # P2: Cond4 (B14) - Cond3 (B13)
  Plate3_log2FC = log2cpm[, "B16"] - log2cpm[, "B15"],  # P3: Cond4 (B16) - Cond3 (B15)
  Plate4_log2FC = log2cpm[, "B18"] - log2cpm[, "B17"]   # P4: Cond4 (B18) - Cond3 (B17)
)

# Preserve gene Ensembl IDs as row names
rownames(paired_log2fc_4col) <- rownames(log2cpm)

# Export reviewer-requested 4-column response matrix
write.csv(paired_log2fc_4col, "reviewer_plate_level_paired_log2FC_matrix_exp2.csv", quote = FALSE)

# ------------------------------------------------------------------------------
# STEP 8: [TRADITIONAL OUTPUT] Fit Linear Model & Extract Recalculated FDR
# ------------------------------------------------------------------------------
# Fit weighted linear regression for every gene incorporating plate baselines
fit <- lmFit(v, design)

# Apply Empirical Bayes moderation to shrink gene variances across the genome
eb_fit <- eBayes(fit)

# Extract full topTable containing average log2FC, t-statistic, p-value, and FDR
# (FDR is now evaluated strictly over protein-coding genes)
traditional_de_1col <- topTable(eb_fit, coef = "ConditionCond4", number = Inf)

# Export traditional 1-column DE output
write.csv(traditional_de_1col, "traditional_limma_voom_DE_results_exp2.csv", quote = FALSE)

cat("PART 1 COMPLETE: Successfully filtered for protein-coding genes and exported both CSV datasets!\n")




# ==============================================================================
# PART 2: ANNOTATION & HIERARCHICAL DEDUPLICATION
# Pipeline: Primary Human Airway Epithelial Cell Transcriptomics
# Software: R (v4.0+), biomaRt, tidyverse
# Description: Annotates 1-column limma-voom DE results and reviewer 4-column 
#              plate log2FC matrices using BioMart with explicit namespace 
#              prefixes for dplyr::select to protect against package masks.
# ==============================================================================

library(tidyverse)
library(biomaRt)

# ------------------------------------------------------------------------------
# STEP 1: Load Datasets & Clean Ensembl IDs
# ------------------------------------------------------------------------------
de_results   <- read_csv("traditional_limma_voom_DE_results_exp2.csv")
plate_log2fc <- read_csv("reviewer_plate_level_paired_log2FC_matrix_exp2.csv")

# Ensure column 1 is named 'ensembl_gene_id' and strip version decimal numbers
de_results <- de_results %>%
  rename(ensembl_gene_id = 1) %>%
  mutate(ensembl_clean = gsub("\\..*", "", ensembl_gene_id))

plate_log2fc <- plate_log2fc %>%
  rename(ensembl_gene_id = 1) %>%
  mutate(ensembl_clean = gsub("\\..*", "", ensembl_gene_id))

# Combine unique IDs for a single efficient BioMart call
all_ensembl_ids <- unique(c(de_results$ensembl_clean, plate_log2fc$ensembl_clean))

# ------------------------------------------------------------------------------
# STEP 2: Connect to BioMart with Mirror & Host Failover Loop
# ------------------------------------------------------------------------------
get_biomart_connection <- function() {
  mirrors_to_try <- c("useast", "asia", "www")
  
  # 1. Try regional mirrors to bypass HTTP 404 / req_perform errors
  for (m in mirrors_to_try) {
    message(paste0("Attempting BioMart connection via mirror: '", m, "'..."))
    mart <- tryCatch({
      useEnsembl(
        biomart = "genes", 
        dataset = "hsapiens_gene_ensembl", 
        mirror  = m
      )
    }, error = function(e) {
      message(paste0("Mirror '", m, "' failed: ", e$message))
      return(NULL)
    })
    
    if (!is.null(mart)) {
      message(paste0("Successfully connected to BioMart via '", m, "' mirror!"))
      return(mart)
    }
  }
  
  # 2. Fallback to direct host URL if mirrors fail
  message("Attempting direct host connection to 'https://www.ensembl.org'...")
  mart <- tryCatch({
    useMart(
      biomart = "ENSEMBL_MART_ENSEMBL",
      dataset = "hsapiens_gene_ensembl",
      host    = "https://www.ensembl.org"
    )
  }, error = function(e) {
    stop("CRITICAL: All BioMart mirrors and direct host connections failed.")
  })
  
  return(mart)
}

# Establish mart connection
mart <- get_biomart_connection()

# Fetch annotations with safety catch
message("Fetching gene annotations from BioMart...")
gene_annot_raw <- tryCatch({
  getBM(
    attributes = c("ensembl_gene_id", "hgnc_symbol", "gene_biotype"),
    filters    = "ensembl_gene_id",
    values     = all_ensembl_ids,
    mart       = mart
  )
}, error = function(e) {
  message("getBM failed on primary connection. Retrying with direct host...")
  fallback_mart <- useMart("ENSEMBL_MART_ENSEMBL", dataset = "hsapiens_gene_ensembl", host = "https://www.ensembl.org")
  getBM(
    attributes = c("ensembl_gene_id", "hgnc_symbol", "gene_biotype"),
    filters    = "ensembl_gene_id",
    values     = all_ensembl_ids,
    mart       = fallback_mart
  )
})

# ------------------------------------------------------------------------------
# STEP 3: Deduplication & Filtering (With Explicit dplyr::select)
# ------------------------------------------------------------------------------
id_map_clean <- gene_annot_raw %>%
  mutate(
    ensembl_gene_id_clean = as.character(ensembl_gene_id),
    hgnc_symbol          = as.character(hgnc_symbol),
    gene_biotype         = as.character(gene_biotype)
  ) %>%
  dplyr::select(-ensembl_gene_id) %>%  # Explicit namespace call
  # 1. Strip empty or NA symbols so they don't corrupt downstream mapping
  filter(hgnc_symbol != "" & !is.na(hgnc_symbol)) %>%
  # 2. Prioritize "protein_coding" biotypes to the top per Ensembl ID
  arrange(ensembl_gene_id_clean, desc(gene_biotype == "protein_coding")) %>%
  # 3. Collapse duplicates by keeping only the top entry
  distinct(ensembl_gene_id_clean, .keep_all = TRUE) %>%
  rename(
    ensembl_gene_id = ensembl_gene_id_clean,
    gene_name       = hgnc_symbol
  )

# ------------------------------------------------------------------------------
# STEP 4: Annotate & Export Datasets (With Explicit dplyr::select)
# ------------------------------------------------------------------------------
# 1. Traditional 1-column DE Results
de_results_annotated <- de_results %>%
  left_join(id_map_clean, by = c("ensembl_clean" = "ensembl_gene_id")) %>%
  mutate(gene_name = ifelse(is.na(gene_name), ensembl_clean, gene_name)) %>%
  mutate(gene_biotype = ifelse(is.na(gene_biotype), "unknown", gene_biotype)) %>%
  dplyr::select(-ensembl_clean)  # Explicit namespace call

write_csv(de_results_annotated, "traditional_limma_voom_DE_results_exp2_annotated.csv")

# 2. Reviewer 4-column Plate Log2FC Matrix
plate_log2fc_annotated <- plate_log2fc %>%
  left_join(id_map_clean, by = c("ensembl_clean" = "ensembl_gene_id")) %>%
  mutate(gene_name = ifelse(is.na(gene_name), ensembl_clean, gene_name)) %>%
  mutate(gene_biotype = ifelse(is.na(gene_biotype), "unknown", gene_biotype)) %>%
  dplyr::select(-ensembl_clean)  # Explicit namespace call

write_csv(plate_log2fc_annotated, "reviewer_plate_level_paired_log2FC_matrix_exp2_annotated.csv")

cat("PART 2 COMPLETE: Successfully annotated and saved both Experiment 2 datasets!\n")




# ==============================================================================
# PART 3: INTEGRATED PATHWAY EVALUATION OF TARGET GENE SET
# Pipeline: Primary Human Airway Epithelial Cell Transcriptomics
# Palette: Medium Lavender (#998CDC), Deep Purple (#5C439D), Forest Green (#084003)
# Part A: Candidate GSEA & Visual Mountain Plot (fgsea + ggplot2)
# Part B: 5-Panel Gene-Level Heatmap with Leading Edge Marking (ComplexHeatmap)
# ==============================================================================

library(tidyverse)
library(fgsea)
library(ComplexHeatmap)
library(circlize)
library(grid)
library(cowplot)

# ------------------------------------------------------------------------------
# STEP 1: Define Target Gene Set & Load Input Data
# ------------------------------------------------------------------------------
targeted_set <- list(
  "Type_I_III_IFN_Antiviral" = c(
    "IFNB1", "IFNL1", "IFNL2", "IFNL3", "IFNAR1", "IFNAR2", "IFNLR1", "IL10RB", 
    "JAK1", "TYK2", "STAT1", "STAT2", "IRF1", "IRF9", "MX1", "MX2", "IFITM1", 
    "IFITM2", "IFITM3", "OAS1", "OAS2", "OAS3", "EIF2AK2", "RSAD2", "IFIT1", 
    "IFIT2", "IFIT3", "ISG15", "ISG20", "IFI6"
  )
)

de_results_full    <- read_csv("traditional_limma_voom_DE_results_exp2_annotated.csv")
plate_log2fc_named <- read_csv("reviewer_plate_level_paired_log2FC_matrix_exp2_annotated.csv")

# ------------------------------------------------------------------------------
# STEP 2: Execute Targeted GSEA (fgsea) & Extract Leading Edge
# ------------------------------------------------------------------------------
if ("t" %in% colnames(de_results_full)) {
  rank_col <- "t"
} else if ("logFC" %in% colnames(de_results_full)) {
  rank_col <- "logFC"
} else if ("log2FC" %in% colnames(de_results_full)) {
  rank_col <- "log2FC"
} else {
  stop("Error: Neither 't', 'logFC', nor 'log2FC' found in DE results CSV.")
}

message(paste0("Ranking full genome using column: '", rank_col, "'"))

de_ranked <- de_results_full %>%
  filter(!is.na(gene_name), !is.na(.data[[rank_col]])) %>%
  distinct(gene_name, .keep_all = TRUE)

stats_vector <- setNames(de_ranked[[rank_col]], de_ranked$gene_name)
stats_vector <- sort(stats_vector, decreasing = TRUE)

set.seed(42)
gsea_results <- fgsea(
  pathways = targeted_set,
  stats   = stats_vector,
  minSize = 5,
  maxSize = 500
)

nes_val  <- sprintf("%.2f", gsea_results$NES[1])
pval_val <- formatC(gsea_results$pval[1], format = "e", digits = 2)
padj_val <- formatC(gsea_results$padj[1], format = "e", digits = 2)
leading_edge_genes <- unlist(gsea_results$leadingEdge[1])

cat(paste0("\n=== GSEA RESULTS SUMMARY ===\n",
           "NES: ", nes_val, " | Nominal P: ", pval_val, " | FDR q: ", padj_val, "\n",
           "Leading Edge Genes (", length(leading_edge_genes), "/", 
           length(targeted_set[[1]]), "): ", paste(leading_edge_genes, collapse=", "), "\n\n"))

# ------------------------------------------------------------------------------
# STEP 3: Build Custom GSEA Mountain Plot (Manuscript Palette Theme)
# ------------------------------------------------------------------------------
gsea_curve <- plotEnrichmentData(
  pathway = targeted_set[["Type_I_III_IFN_Antiviral"]],
  stats  = stats_vector
)

p_mountain <- ggplot(gsea_curve$curve, aes(x = rank, y = ES)) +
  geom_line(color = "#5C439D", linewidth = 1.2) +  # Primary curve: Deep Purple
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray50", linewidth = 0.5) +
  geom_segment(data = gsea_curve$ticks, 
               aes(x = rank, xend = rank, y = -0.05, yend = -0.01), 
               color = "#084003", alpha = 0.7, linewidth = 0.4) +  # Ticks: Forest Green
  theme_classic(base_size = 11) +
  labs(
    title = "Gene Set Enrichment Analysis: Type I & III IFN Signaling",
    x    = paste0("Rank in Ordered Dataset (Genome-Wide ", rank_col, ")"),
    y    = "Running Enrichment Score (ES)"
  ) +
  annotate(
    "label", 
    x    = max(gsea_curve$curve$rank) * 0.75, 
    y    = max(gsea_curve$curve$ES) * 0.85,
    label = paste0("NES = ", nes_val, "\nNominal p = ", pval_val, "\nFDR q = ", padj_val, 
                   "\nLeading Edge = ", length(leading_edge_genes), "/", length(targeted_set[[1]])),
    fill = "#F2EFFB", color = "#5C439D", fontface = "bold", size = 3.5
  ) +
  theme(
    plot.title       = element_text(face = "bold", size = 12, hjust = 0.5),
    axis.title       = element_text(face = "bold", size = 10),
    panel.grid.major = element_line(color = "#F5F5F5")
  )

ggsave("Exp2_SingleSet_GSEA_MountainPlot.png", plot = p_mountain, width = 8, height = 4.5, dpi = 300)

# ------------------------------------------------------------------------------
# STEP 4: Filter & Prepare Gene-Level Data for Heatmap
# ------------------------------------------------------------------------------
ifn_df <- enframe(targeted_set, name = "Group", value = "gene_name") %>% unnest(cols = c(gene_name))

ifn_matched       <- ifn_df %>% inner_join(de_results_full, by = "gene_name")
ifn_matched_plate <- ifn_df %>% inner_join(plate_log2fc_named, by = "gene_name")

common_genes      <- intersect(ifn_matched$gene_name, ifn_matched_plate$gene_name)
ifn_matched       <- ifn_matched %>% filter(gene_name %in% common_genes)
ifn_matched_plate <- ifn_matched_plate %>% filter(gene_name %in% common_genes)

ifn_matched <- ifn_matched %>%
  mutate(
    is_leading_edge = ifelse(gene_name %in% leading_edge_genes, "Core Driver", "Other"),
    adj.P.Val       = ifelse(is.na(adj.P.Val), 1, adj.P.Val),
    P.Value         = ifelse(is.na(P.Value), 1, P.Value),
    target_fdr      = p.adjust(P.Value, method = "BH"),
    neg_log10_fdr   = -log10(adj.P.Val),
    neg_log10_target_fdr = -log10(target_fdr),
    neg_log10_rawp  = -log10(P.Value),
    sig_symbol      = case_when(
      adj.P.Val < 0.001 ~ "***",
      adj.P.Val < 0.01  ~ "**",
      adj.P.Val < 0.05  ~ "*",
      TRUE              ~ ""
    ),
    fdr_text = case_when(
      adj.P.Val < 0.001 ~ formatC(adj.P.Val, format = "e", digits = 1),
      adj.P.Val < 0.99  ~ sprintf("%.3f", adj.P.Val),
      TRUE              ~ "1.00"
    ),
    target_fdr_text = case_when(
      target_fdr < 0.001 ~ formatC(target_fdr, format = "e", digits = 1),
      target_fdr < 0.99  ~ sprintf("%.3f", target_fdr),
      TRUE               ~ "1.00"
    ),
    rawp_text = case_when(
      P.Value < 0.001 ~ formatC(P.Value, format = "e", digits = 1),
      P.Value < 0.99  ~ sprintf("%.3f", P.Value),
      TRUE            ~ "1.00"
    )
  )

# ------------------------------------------------------------------------------
# STEP 5: Construct Matrices & Annotations (Manuscript Palette Alignment)
# ------------------------------------------------------------------------------
mat_4col <- as.matrix(ifn_matched_plate[, c("Plate1_log2FC", "Plate2_log2FC", "Plate3_log2FC", "Plate4_log2FC")])
colnames(mat_4col) <- c("P1", "P2", "P3", "P4")
rownames(mat_4col) <- ifn_matched_plate$gene_name

mat_1col <- as.matrix(ifn_matched[, "logFC", drop = FALSE])
colnames(mat_1col) <- "Pop. log2FC"
rownames(mat_1col) <- ifn_matched$gene_name

mat_fdr <- as.matrix(ifn_matched[, "neg_log10_fdr", drop = FALSE])
colnames(mat_fdr) <- "Genome FDR"
rownames(mat_fdr) <- ifn_matched$gene_name

mat_target_fdr <- as.matrix(ifn_matched[, "neg_log10_target_fdr", drop = FALSE])
colnames(mat_target_fdr) <- "Target FDR"
rownames(mat_target_fdr) <- ifn_matched$gene_name

