plot_target_ridge <- function(target_df, pathways_list, stats, db_label) {
  ridge_data_list <- list()
  
  for (i in seq_len(nrow(target_df))) {
    pw_name  <- target_df$pathway[i]
    pw_group <- target_df$group[i]
    pw_genes <- intersect(pathways_list[[pw_name]], names(stats))
    
    if (length(pw_genes) > 0) {
      clean_name <- gsub("^HALLMARK_|^GOBP_", "", pw_name)
      clean_name <- gsub("_", " ", clean_name)
      
      ridge_data_list[[i]] <- tibble(
        pathway = clean_name,
        group   = pw_group,
        stat    = stats[pw_genes]
      )
    }
  }
  
  ridge_df <- bind_rows(ridge_data_list) %>%
    mutate(pathway = str_wrap(pathway, width = 40))
  
  pathway_order <- ridge_df %>%
    group_by(pathway) %>%
    summarise(mean_stat = mean(stat)) %>%
    arrange(mean_stat) %>%
    pull(pathway)
  
  ridge_df <- ridge_df %>% mutate(pathway = factor(pathway, levels = pathway_order))
  
  ggplot(ridge_df, aes(x = stat, y = pathway, fill = ..x..)) +
    geom_density_ridges_gradient(scale = 1.3, rel_min_height = 0.01, color = "white", linewidth = 0.3) +
    geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
    scale_fill_gradient2(
      low = "#084003", mid = "#FBFBF9", high = "#5C439D", midpoint = 0,
      name = paste0("Rank Metric (", rank_col, ")")
    ) +
    facet_grid(group ~ ., scales = "free_y", space = "free_y") +
    theme_classic(base_size = 11) +
    labs(
      title = paste0("Ranked Expression Distribution (padj < 0.05, Top NES): ", db_label),
      x     = paste0("Gene-Level Ranking Statistic (", rank_col, ")"),
      y     = NULL
    ) +
    theme(
      plot.title         = element_text(face = "bold", size = 11, hjust = 0.5),
      axis.text.y        = element_text(size = 8.5, face = "bold"),
      axis.title.x       = element_text(face = "bold", size = 10),
      strip.background   = element_rect(fill = "#F2EFFB", color = "#5C439D"),
      strip.text         = element_text(face = "bold", color = "#3A2272", size = 9.5),
      panel.grid.major.y = element_line(color = "#F0F0F0")
    )
}

