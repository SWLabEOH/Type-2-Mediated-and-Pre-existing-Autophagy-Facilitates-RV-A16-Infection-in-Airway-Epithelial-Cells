# ------------------------------------------------------------------------------
# STEP 1: Load Full Genome DE Results & Prepare Rankings
# ------------------------------------------------------------------------------
de_results_full <- read_csv("traditional_limma_voom_DE_results_exp2_annotated.csv")

# Determine available ranking metric (prefer 't', fall back to 'logFC' / 'log2FC')
if ("t" %in% colnames(de_results_full)) {
  rank_col <- "t"
} else if ("logFC" %in% colnames(de_results_full)) {
  rank_col <- "logFC"
} else if ("log2FC" %in% colnames(de_results_full)) {
  rank_col <- "log2FC"
} else {
  stop("Error: Neither 't', 'logFC', nor 'log2FC' found in DE results CSV.")
}

message(paste0("Ranking full genome using column: '", rank_col, "'"))

# Clean and rank gene vector
de_ranked <- de_results_full %>%
  filter(!is.na(gene_name), !is.na(.data[[rank_col]])) %>%
  distinct(gene_name, .keep_all = TRUE)

stats_vector <- setNames(de_ranked[[rank_col]], de_ranked$gene_name)
stats_vector <- sort(stats_vector, decreasing = TRUE)

# ------------------------------------------------------------------------------
# STEP 2: Fetch MSigDB Gene Sets (Human)
# ------------------------------------------------------------------------------
hs_hallmark <- msigdbr(species = "Homo sapiens", category = "H") %>%
  split(x = .$gene_symbol, f = .$gs_name)

hs_gobp <- msigdbr(species = "Homo sapiens", category = "C5", subcategory = "BP") %>%
  split(x = .$gene_symbol, f = .$gs_name)

# ------------------------------------------------------------------------------
# STEP 3: Execute fgsea across Collections (Multi-level Sampling)
# ------------------------------------------------------------------------------
set.seed(42)

# Run Hallmark GSEA
