  pathways = hs_hallmark,
  stats    = stats_vector,
  minSize  = 15,
  maxSize  = 500
) %>%
  as_tibble() %>%
  arrange(padj)

# Run GO:BP GSEA
gsea_gobp <- fgsea(
  pathways = hs_gobp,
  stats    = stats_vector,
  minSize  = 15,
  maxSize  = 500
) %>%
  as_tibble() %>%
  arrange(padj)

